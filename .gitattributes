# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.java text
*.fxml text
*.html text
*.c text
*.h text
*.cpp text
*.cs text
*.txt text
*.bat text

# Vendor raw data committed as test resources. These are OLE compound documents:
# declaring them binary stops `* text=auto` from ever line-ending-normalizing
# them, which would silently corrupt them in a fresh clone on another platform.
*.lcd binary
*.qgd binary

